#!/usr/bin/env bash

set -euo pipefail

CAREER_FEED_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
  cat <<'EOF'
현재 GitHub 상태를 확인해 실행 가능한 Spring 생태계 OSS 후보를 추천합니다.

사용법:
  ./career-feed          공개 GitHub API로 후보 확인
  ./career-feed check    저장소 검증
  ./career-feed help     도움말 보기

이 도구는 issue를 읽기만 하며 comment, assign, branch, fork, PR을 만들지 않습니다.
EOF
}

if (($# == 0)); then
  exec python3 "${CAREER_FEED_ROOT}/scripts/collect_oss_candidates.py" \
    --live-dry-run \
    --stdout
fi

command_name="$1"
shift

case "${command_name}" in
  check)
    if (($# != 0)); then
      echo "check 명령은 추가 옵션을 받지 않습니다." >&2
      exit 2
    fi
    exec "${CAREER_FEED_ROOT}/scripts/validate.sh"
    ;;
  help | -h | --help)
    if (($# != 0)); then
      echo "help 명령은 추가 옵션을 받지 않습니다." >&2
      exit 2
    fi
    show_help
    ;;
  *)
    echo "알 수 없는 명령: ${command_name}" >&2
    show_help >&2
    exit 2
    ;;
esac
