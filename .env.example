# Example values for local tests and documentation reference.
# GitHub Actions Secrets and Variables must be configured in the GitHub repository UI.
# This file does not configure repository Actions by itself.

# Required secret for the first manual dry-run
OPENAI_API_KEY=your-openai-api-key

# Optional generic Discord webhook secret
DISCORD_WEBHOOK_CAREER_FEED=your-discord-webhook-url

# Optional locale-specific Discord webhook secrets
DISCORD_WEBHOOK_KO_KR_BACKEND_DAILY=your-discord-webhook-url
DISCORD_WEBHOOK_EN_US_BACKEND_DAILY=your-discord-webhook-url
DISCORD_WEBHOOK_KO_KR_NEWS_DAILY=your-discord-webhook-url
DISCORD_WEBHOOK_EN_US_NEWS_DAILY=your-discord-webhook-url

# Optional compatibility Discord webhook secrets for ko-KR
DISCORD_WEBHOOK_KR_TECH_DAILY=your-discord-webhook-url
DISCORD_WEBHOOK_KR_TECH_NEWS_DAILY=your-discord-webhook-url
DISCORD_WEBHOOK_BACKEND_CAREER_WEEKLY=your-discord-webhook-url
DISCORD_WEBHOOK_CAREER_FEED_OPS=your-discord-webhook-url

# Optional search provider secrets
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Runtime configuration variables
CAREER_FEED_ENABLED_LOCALES=ko-KR
CAREER_FEED_DEFAULT_LOCALE=ko-KR
CAREER_FEED_SEARCH_PROVIDERS_KO_KR=naver,rss,github
CAREER_FEED_SEARCH_PROVIDERS_EN_US=brave,rss,github
CAREER_FEED_TIMEZONE=Asia/Seoul
CAREER_FEED_BACKEND_DAILY_TIME=09:00
CAREER_FEED_NEWS_DAILY_TIME=09:05
CAREER_FEED_CAREER_WEEKLY_DAY=MON
CAREER_FEED_CAREER_WEEKLY_TIME=09:00
CAREER_FEED_OSS_RECENT_DAYS=30
CAREER_FEED_SCHEDULE_ENABLED=false
CAREER_FEED_DISCORD_DELIVERY_ENABLED=false
