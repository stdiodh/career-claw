# Shared EC2 Nginx example for claw.stdiodh.xyz
# Use this in the existing didimlog Nginx/certbot stack.
# The backend app is exposed by career-claw on host port 8082.

server {
    listen 80;
    server_name claw.stdiodh.xyz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Enable this block after issuing a certificate for claw.stdiodh.xyz.
server {
    listen 443 ssl;
    http2 on;
    server_name claw.stdiodh.xyz;

    ssl_certificate /etc/letsencrypt/live/claw.stdiodh.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/claw.stdiodh.xyz/privkey.pem;

    location / {
        proxy_pass http://172.31.36.159:8082;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
