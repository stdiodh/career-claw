{
  "persona": {
    "age": 25,
    "education": "4-year university student or upcoming graduate",
    "target_role": "backend developer",
    "level": "student/intern/junior",
    "primary_stack": ["Kotlin", "Spring Boot", "Java", "REST API", "SQL"],
    "secondary_stack": ["Docker", "Kubernetes", "AWS", "Redis", "Kafka", "PostgreSQL"],
    "location": "Korea",
    "language": "ko"
  },
  "preferences": {
    "daily_topics": ["kr-ai-tech", "kr-backend-dev-tech"],
    "weekly_topics": ["backend-internship", "hackathon", "contest", "competition"],
    "exclude": [
      "price-move-only",
      "personal-investment-advice",
      "senior-only",
      "frontend-only",
      "marketing-only",
      "expired-deadline"
    ],
    "content_tracks": {
      "enabled": true,
      "daily_total_items": {
        "min": 3,
        "max": 5,
        "default": 4
      },
      "daily_ratio_policy": {
        "default_total_items": 4,
        "target_tech_items": 3,
        "target_investment_items": 1,
        "max_total_items": 5,
        "allow_zero_investment_when_quality_low": true,
        "allow_second_investment_when": [
          "investment item has clear technology driver",
          "investment item is based on earnings, disclosure, CAPEX, data center, GPU/HBM, cloud, enterprise AI, API/platform revenue",
          "at least two tech items are also selected",
          "the second investment item is not about the same company or same event"
        ],
        "prefer_tech_when": [
          "investment candidates are price-move-only",
          "investment candidates repeat the same company too often",
          "investment candidates lack technology_link",
          "growth action would become vague"
        ]
      },
      "tech": {
        "enabled": true,
        "min_items": 2,
        "max_items": 3,
        "preferred_topics": [
          "AI API",
          "LLM",
          "Backend",
          "Cloud",
          "Security",
          "Data",
          "Developer Productivity",
          "Open Source"
        ]
      },
      "investment": {
        "enabled": true,
        "min_items": 0,
        "max_items": 2,
        "allowed_when": [
          "earnings or guidance linked to AI/cloud/backend infrastructure",
          "AI semiconductor, GPU, HBM, data center, server demand",
          "cloud CAPEX or enterprise AI spending",
          "developer platform/API/SDK business impact",
          "official disclosure or major media report about technology-driven business change"
        ],
        "soft_risk_flags": [
          "stock price movement",
          "target price mentioned",
          "analyst opinion mentioned",
          "earnings surprise",
          "CAPEX",
          "orders",
          "guidance"
        ],
        "hard_exclude_when": [
          "theme stock list",
          "related stock list",
          "pump-and-dump style",
          "buy/sell command",
          "guaranteed return",
          "price movement only without business or technology driver"
        ]
      },
      "bridge": {
        "enabled": true,
        "required_when_both_tracks_exist": true
      },
      "growth_check": {
        "enabled": true,
        "required": true,
        "score_range": [1, 5],
        "must_include_one_action": true
      }
    },
    "market_context": {
      "enabled": true,
      "compatibility_note": "Kept for previous News Daily readers; prefer content_tracks.investment.",
      "max_items_per_day": 1,
      "allow_when": [
        "AI infrastructure investment",
        "cloud/datacenter/GPU/HBM/server demand",
        "developer platform/API/SDK ecosystem impact",
        "backend/cloud hiring or skill demand impact"
      ],
      "exclude_when": [
        "stock price only",
        "target price",
        "buy/sell recommendation",
        "theme stock",
        "related stock list"
      ]
    }
  }
}
